# PayPilot Global — environment template
#
# Copy to .env and fill in real values:   cp .env.example .env
# .env is gitignored. This file is committed so nobody has to guess the keys.
#
# Generate a JWT_SECRET with:
#   python3 -c "import secrets; print(secrets.token_urlsafe(48))"

APP_ENV=demo
DEMO_MODE=true
# Database Configuration (MySQL via XAMPP - default: no password for root)
DATABASE_URL=mysql+pymysql://root@localhost:3306/paypilot_global
BMONI_BASE_URL=https://embedded-dev.bmoni.com
BMONI_API_KEY=demo_key_paypilot_2026
BMONI_WEBHOOK_SECRET=replace_me_bmoni_webhook_secret

# Flutterwave Configuration (Primary SDK)
FLUTTERWAVE_BASE_URL=https://api.flutterwave.com/v3
FLUTTERWAVE_SECRET_KEY=FLWSECK_TEST-your_test_secret_key_here
FLUTTERWAVE_PUBLIC_KEY=FLWPUBK_TEST-your_test_public_key_here
FLUTTERWAVE_WEBHOOK_SECRET=replace_me_flutterwave_webhook_secret
REDIS_URL=redis://localhost:6379/0
JWT_SECRET=generate_with__python3_-c_import_secrets_print_secrets_token_urlsafe_48
JWT_ALGORITHM=HS256
JWT_EXPIRATION_HOURS=24
DEMO_EMPLOYER_ID=demo-employer-001
CSV_MAX_ROWS=5000
CSV_MAX_SIZE_MB=5
RATE_LIMIT_PER_MINUTE=60
